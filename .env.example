TELEGRAM_BOT_TOKEN=123456789:replace_me
TELEGRAM_CHAT_ID=123456789

# Codex app-server that this bridge connects to.
CODEX_UPSTREAM_WS=ws://127.0.0.1:8765

# WebSocket endpoint exposed by this bridge for `codex --remote`.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8766

# Optional: mirror assistant text to Telegram. Set to 0 to only send approvals.
MIRROR_AGENT_MESSAGES=1
