TELEGRAM_BOT_TOKEN=123456789:replace_me
TELEGRAM_CHAT_ID=123456789

# Optional: explicit Codex CLI path. Useful on macOS if `codex` is not in PATH.
# CODEX_BIN=/Applications/Codex.app/Contents/Resources/codex

# Codex app-server that this bridge connects to.
CODEX_UPSTREAM_WS=ws://127.0.0.1:8765

# WebSocket endpoint exposed by this bridge for `codex --remote`.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8766

# Optional: mirror assistant text to Telegram. Set to 0 to only send approvals.
MIRROR_AGENT_MESSAGES=1

# Optional: mirror low-level turn/item/command process events. This is noisy; keep 0 for normal use.
MIRROR_PROCESS_EVENTS=0

# Optional: include raw approval request params in Telegram approval messages. This can be verbose.
INCLUDE_APPROVAL_PARAMS=0

# Optional: log bridge JSON-RPC requests/responses for debugging Telegram slash commands.
BRIDGE_DEBUG_RPC=0

# Optional: HTTP proxy for Telegram API, for example Clash.
# TELEGRAM_PROXY=http://127.0.0.1:8888
