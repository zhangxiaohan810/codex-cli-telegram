TELEGRAM_BOT_TOKEN=123456789:replace_me
TELEGRAM_CHAT_ID=123456789

# Approval notification channel: telegram, keyboard, or both.
NOTIFICATION_CHANNEL=telegram

# Optional: explicit Codex CLI path. Useful on macOS if `codex` is not in PATH.
# CODEX_BIN=/Applications/Codex.app/Contents/Resources/codex

# Codex app-server that this bridge connects to.
CODEX_UPSTREAM_WS=ws://127.0.0.1:8765

# WebSocket endpoint exposed by this bridge for `codex --remote`.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8766

# Local TCP control socket used by `codex-telegram` to type Telegram input into the screen Codex CLI.
PTY_CONTROL_HOST=127.0.0.1
PTY_CONTROL_PORT=8767

# `tui` sends Telegram text and slash commands through the screen Codex CLI.
# Set to `rpc` to keep legacy direct app-server text injection for normal messages.
TELEGRAM_INPUT_MODE=tui

# Optional: Python executable used by the PTY driver.
# PYTHON_BIN=python3

# Optional: mirror assistant text to Telegram. Set to 0 to only send approvals.
MIRROR_AGENT_MESSAGES=1

# Optional: mirror low-level turn/item/command process events. This is noisy; keep 0 for normal use.
MIRROR_PROCESS_EVENTS=0

# Optional: include raw approval request params in Telegram approval messages. This can be verbose.
INCLUDE_APPROVAL_PARAMS=0

# Optional: log bridge JSON-RPC requests/responses for debugging Telegram slash commands.
BRIDGE_DEBUG_RPC=0

# Optional: run a command while at least one Codex approval request is pending.
# Example for a local macOS Logitech G610 setup:
# MAC_HOST=TiezhuMacBook-Air.local
# APPROVAL_REQUEST_START_CMD=ssh -o BatchMode=yes -o ConnectTimeout=5 Tiezhu@$MAC_HOST '~/bin/g610-blink-start'
# APPROVAL_REQUEST_STOP_CMD=ssh -o BatchMode=yes -o ConnectTimeout=5 Tiezhu@$MAC_HOST '~/bin/g610-blink-stop'
# For a bridge running on the same Mac:
# APPROVAL_REQUEST_START_CMD=sudo python /path/to/codex-cli-telegram/scripts/g610_blink10.py
# APPROVAL_REQUEST_STOP_CMD=

# Optional: retry transient Telegram API network failures such as ECONNRESET.
TELEGRAM_RETRIES=2

# Optional: conservative per-message HTML size budget for Telegram splitting.
TELEGRAM_SAFE_MESSAGE_LIMIT=3800

# Optional: HTTP proxy for Telegram API, for example Clash.
# TELEGRAM_PROXY=http://127.0.0.1:8888
